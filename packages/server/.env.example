# 复制为 .env 使用。前缀 ENERSIGHT_，见 app/config.py
ENERSIGHT_DEBUG=true
ENERSIGHT_DATABASE_URL=sqlite+aiosqlite:///./enersight.db
# 生产：postgresql+asyncpg://user:pass@host:5432/enersight

# 生产必填，至少 32 字节
ENERSIGHT_JWT_SECRET=

# 微信小程序。未配置时 debug 模式走开发态登录
ENERSIGHT_WX_APPID=
ENERSIGHT_WX_SECRET=

# 腾讯位置服务 WebService key。未配置时逆地理编码不可用、搜索只匹配站点与坐标
ENERSIGHT_TENCENT_LBS_KEY=

# AI。rule = 规则模板（默认）；claude 需另设 ANTHROPIC_API_KEY
ENERSIGHT_AI_PROVIDER=rule
