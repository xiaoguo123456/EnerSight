# EnerSight 测试环境变量示例。复制为 deploy/.env 后填写，chmod 600，禁止提交。
# 前缀 ENERSIGHT_，全部键见 packages/server/app/config.py

ENERSIGHT_DEBUG=false
TZ=Asia/Shanghai

# PostgreSQL（外部托管，内网地址；密码需 URL 编码：@ → %40，# → %23，% → %25）
ENERSIGHT_DATABASE_URL=postgresql+asyncpg://enersight_test_app:<URL编码后的密码>@<RDS内网地址>:5432/enersight_test
ENERSIGHT_DB_POOL_SIZE=2
ENERSIGHT_DB_MAX_OVERFLOW=1
ENERSIGHT_ROOT_PATH=/enersight

# 气象代理池：默认直连。开启后所有 Open-Meteo 出网都经代理池，按实测出口分账与冷却。
# 候选是免费列表里的节点数，真正决定额度宽度的是**实测独立出口数**（日志 ready_exits）。
ENERSIGHT_WEATHER_PROXY_POOL_ENABLED=false
ENERSIGHT_WEATHER_PROXY_CANDIDATES=100
ENERSIGHT_WEATHER_PROXY_TARGET_EXITS=20
ENERSIGHT_WEATHER_PROXY_MIN_EXITS=5
# 每出口的自设保守阈值（按坐标数计），不是上游承诺额度
ENERSIGHT_WEATHER_PROXY_EXIT_UNITS_PER_MINUTE=300
ENERSIGHT_WEATHER_PROXY_EXIT_UNITS_PER_HOUR=2000
ENERSIGHT_WEATHER_PROXY_EXIT_UNITS_PER_DAY=5000
# 池子给不出出口时退回直连；直连也是账本里的一个出口，额度按免费层留两成余量
ENERSIGHT_WEATHER_PROXY_DIRECT_FALLBACK=true
ENERSIGHT_WEATHER_PROXY_DIRECT_UNITS_PER_DAY=8000
# 其余可调项见 packages/server/app/config.py 的 weather_proxy_* 与 docs/10「气象出网」

# 至少 32 字节的高强度随机值；泄露等于所有用户 token 失效
ENERSIGHT_JWT_SECRET=<高强度随机密钥>

# 微信小程序（真 code2session）
ENERSIGHT_WX_APPID=wx61a4a74de8bc126b
ENERSIGHT_WX_SECRET=

# 腾讯位置服务 WebService key；不填则逆地理不可用、搜索只匹配站点与坐标
ENERSIGHT_TENCENT_LBS_KEY=

# AI：rule（规则模板，默认）或 claude（需 ANTHROPIC_API_KEY）
ENERSIGHT_AI_PROVIDER=rule
ANTHROPIC_API_KEY=

# 定时任务与卫星归档：单实例开；多实例只在一台上开，否则重复扫描
ENERSIGHT_ENABLE_SCHEDULER=false
ENERSIGHT_ENABLE_ARCHIVE=false
ENERSIGHT_ARCHIVE_RETENTION_DAYS=60

# 限流：每 token / IP 每分钟请求数。ALB 前置且安全组已挡直连时才开 forwarded_for
ENERSIGHT_RATE_LIMIT_PER_MINUTE=120
ENERSIGHT_TRUST_FORWARDED_FOR=true

# 公开电站目录按月同步：定时任务用这组信息提交 Global Energy Monitor 的下载表单，空则不同步
ENERSIGHT_GEM_CONTACT_NAME=
ENERSIGHT_GEM_CONTACT_EMAIL=
ENERSIGHT_GEM_CONTACT_ORG=EnerSight
ENERSIGHT_CATALOG_SYNC_DAYS=30

# 测试 ECS 与其他业务共用内存，默认关闭全量后台采集；专项验收时再开启。
