{
  "name": "enersight",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build:test": "pnpm --filter @enersight/miniapp build:weapp:test",
    "build:prod": "pnpm --filter @enersight/miniapp build:weapp:prod"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tarojs/binding",
      "@swc/core",
      "esbuild",
      "@parcel/watcher",
      "core-js"
    ]
  }
}
